@import "tailwindcss";

@theme {
  --font-display: "Playfair Display", Georgia, serif;
  --font-script: "Marck Script", "Segoe Script", cursive;
  --font-sans: "Nunito", system-ui, -apple-system, "Segoe UI", sans-serif;
}

html,
body,
#root {
  min-height: 100%;
}

body {
  margin: 0;
  background: #061a44;
  font-family: var(--font-sans);
  color: #eaf6ff;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

::selection {
  background: rgba(130, 200, 255, 0.5);
}

/* ---------- анимации ---------- */
@keyframes sway {
  0%,
  100% {
    transform: rotate(-4deg);
  }
  50% {
    transform: rotate(4deg);
  }
}
@keyframes twinkle {
  0%,
  100% {
    opacity: 0.4;
    transform: scale(0.8);
  }
  50% {
    opacity: 1;
    transform: scale(1.15);
  }
}
@keyframes floaty {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}
@keyframes spin-slow {
  to {
    transform: rotate(360deg);
  }
}
@keyframes spin-rev {
  to {
    transform: rotate(-360deg);
  }
}
@keyframes shimmer {
  to {
    background-position: 200% center;
  }
}
@keyframes swoosh {
  0% {
    transform: translateX(-130%);
  }
  100% {
    transform: translateX(230%);
  }
}
@keyframes flyacross {
  0% {
    transform: translate(-15vw, 0) rotate(0deg);
    opacity: 0;
  }
  15% {
    opacity: 1;
  }
  85% {
    opacity: 1;
  }
  100% {
    transform: translate(115vw, 60px) rotate(360deg);
    opacity: 0;
  }
}
@keyframes shake {
  0%,
  100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-9px);
  }
  40% {
    transform: translateX(8px);
  }
  60% {
    transform: translateX(-6px);
  }
  80% {
    transform: translateX(4px);
  }
}
@keyframes bokeh {
  0%,
  100% {
    transform: translate(0, 0) scale(1);
  }
  50% {
    transform: translate(18px, -26px) scale(1.12);
  }
}
@keyframes aurora {
  0%,
  100% {
    transform: translate(-6%, 0) scale(1);
    opacity: 0.5;
  }
  50% {
    transform: translate(6%, -4%) scale(1.15);
    opacity: 0.85;
  }
}
@keyframes hintbob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(8px);
  }
}
@keyframes glowpulse {
  0%,
  100% {
    box-shadow: 0 0 30px 4px rgba(140, 210, 255, 0.35);
  }
  50% {
    box-shadow: 0 0 55px 12px rgba(170, 225, 255, 0.65);
  }
}

.sway {
  animation: sway 5s ease-in-out infinite;
  transform-origin: 50% 0;
}
.twinkle {
  animation: twinkle 2.4s ease-in-out infinite;
}
.floaty {
  animation: floaty 5s ease-in-out infinite;
}
.spin-slow {
  animation: spin-slow 9s linear infinite;
}
.spin-rev {
  animation: spin-rev 16s linear infinite;
}
.shake {
  animation: shake 0.5s ease-in-out;
}
.hintbob {
  animation: hintbob 1.6s ease-in-out infinite;
}
.glowpulse {
  animation: glowpulse 3.5s ease-in-out infinite;
}

/* ---------- элементы ---------- */
.ice-text {
  background: linear-gradient(180deg, #ffffff 0%, #d8efff 42%, #82c6ff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  filter: drop-shadow(0 4px 16px rgba(120, 190, 255, 0.55));
}

.shimmer-text {
  background: linear-gradient(
    100deg,
    #9fd6ff 0%,
    #ffffff 25%,
    #9fd6ff 50%,
    #ffffff 75%,
    #9fd6ff 100%
  );
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: shimmer 5s linear infinite;
}

.glass {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.07));
  border: 1px solid rgba(255, 255, 255, 0.38);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow:
    0 20px 50px rgba(3, 20, 70, 0.45),
    inset 0 1px 0 rgba(255, 255, 255, 0.55);
}

.field {
  width: 100%;
  border-radius: 16px;
  padding: 14px 16px;
  font-size: 16px;
  font-weight: 700;
  color: #0a2c66;
  background: rgba(255, 255, 255, 0.9);
  border: 2px solid transparent;
  outline: none;
  transition:
    border-color 0.2s,
    box-shadow 0.2s,
    background 0.2s;
}
.field::placeholder {
  color: #6f97c4;
  font-weight: 600;
}
.field:focus {
  background: #fff;
  border-color: #6cc0ff;
  box-shadow: 0 0 0 4px rgba(108, 192, 255, 0.35);
}

.btn-ice {
  position: relative;
  overflow: hidden;
  width: 100%;
  border-radius: 16px;
  padding: 15px 18px;
  font-size: 17px;
  font-weight: 800;
  letter-spacing: 0.03em;
  color: #fff;
  background: linear-gradient(135deg, #3aa0ff 0%, #1f6fe0 55%, #1a4fb8 100%);
  border: 1px solid rgba(255, 255, 255, 0.5);
  box-shadow:
    0 10px 28px rgba(20, 90, 220, 0.55),
    inset 0 1px 0 rgba(255, 255, 255, 0.55);
  transition:
    transform 0.15s,
    filter 0.2s,
    box-shadow 0.2s;
  cursor: pointer;
}
.btn-ice:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}
.btn-ice:active {
  transform: translateY(1px) scale(0.99);
}
.btn-ice:disabled,
.btn-ice[data-locked="true"] {
  background: linear-gradient(135deg, #6d8fb8, #4c6d97);
  box-shadow: none;
  cursor: not-allowed;
  filter: saturate(0.7);
}
.btn-ice::after {
  content: "";
  position: absolute;
  top: 0;
  left: -60%;
  width: 40%;
  height: 100%;
  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.5), transparent);
  transform: skewX(-20deg);
  animation: shine 3.4s ease-in-out infinite;
}
@keyframes shine {
  0% {
    left: -60%;
  }
  55%,
  100% {
    left: 160%;
  }
}

.btn-ghost {
  border-radius: 14px;
  padding: 10px 16px;
  font-weight: 800;
  font-size: 14px;
  color: #e6f4ff;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(10px);
  cursor: pointer;
  transition: background 0.2s;
}
.btn-ghost:hover {
  background: rgba(255, 255, 255, 0.22);
}

/* секретная кнопка — никаких намёков, что она нажимается */
.secret-tap {
  -webkit-tap-highlight-color: transparent;
  -webkit-user-select: none;
  user-select: none;
  touch-action: manipulation;
  outline: none;
  cursor: default;
}
